# Copy to .env for local `netlify dev`. On Netlify, set these under
# Site configuration > Environment variables. Never commit a real key.
GEMINI_API_KEY=
# Optional model overrides
GEMINI_EXTRACT_MODEL=gemini-pro-latest
GEMINI_EVAL_MODEL=gemini-flash-latest
GEMINI_OCR_MODEL=gemini-flash-latest
# Optional: lock the function to your site, e.g. https://your-site.netlify.app
ALLOWED_ORIGIN=
